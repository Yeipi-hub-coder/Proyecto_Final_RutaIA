      "parameters": {
        "jsCode": "const c = $('Preparar Pregunta').first().json;\nconst r = $input.first().json;\nconst pts = r.result?.points ?? r.result ?? [];\n\nconst UMBRAL_MINIMO = 0.5;\n\nconst resultados = pts\n  .filter(p => Number(p.score ?? 0) >= UMBRAL_MINIMO)\n  .map(p => ({\n    cursoId : p.id,\n    nombre : p.payload?.nombre ?? '',\n    descripcion : p.payload?.descripcion ?? '',\n    categoria : p.payload?.categoria ?? '',\n    nivel : p.payload?.nivel ?? '',\n    duracion : p.payload.duracion ?? '', \n    similitud : Number (p.score ?? 0)\n  }));\n\nreturn [{\n  json: {\n    idConsulta: c.idConsulta,\n    pregunta: c.pregunta,\n    resultados,\n    hayResultados: resultados.length > 0\n  }\n}];"
      },
