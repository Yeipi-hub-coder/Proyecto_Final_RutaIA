      "id": "7a8eaed0-996e-42eb-8342-472b611a802e",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst cursos = $('Preparar Puntos').all();\n\nreturn items.map((item, i) => {\n  const curso = cursos[i].json.curso;\n  const embedding = item.json.data[0].embedding;\n\n  return {\n    json: {\n      id: Number(curso.id),\n\n      vector: embedding,\n\n      fecha_actualizacion: curso.fecha_actualizacion,\n\n      payload: {\n        curso_id: curso.id,\n        nombre: curso.nombre,\n        descripcion: curso.descripcion,\n        categoria: curso.categoria,\n        nivel: curso.nivel,\n        duracion: curso.duracion,\n        estado: curso.estado,\n        fecha_actualizacion: curso.fecha_actualizacion\n      }\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
