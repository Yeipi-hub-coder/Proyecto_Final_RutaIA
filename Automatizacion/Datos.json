    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const d = item.json;\n\n  const id = d.id;\n  const nombre = String(d.nombre ?? '').trim();\n  const descripcion = String(d.descripcion ?? '').trim();\n  const categoria = String(d.categoria ?? '').trim();\n  const nivel = String(d.nivel ?? '').trim();\n  const estado = String(d.estado ?? '').trim().toUpperCase();\n\n  const textoEmbedding = [\n    `Curso: ${nombre}`,\n    `Descripción: ${descripcion}`,\n    `Categoría: ${categoria}`,\n    `Nivel: ${nivel}`,\n  ].join('. ');\n\n  return {\n    json: {\n      qdrant_url: 'http://qdrant:6333',\n      coleccion: 'cursos-RutaIA',\n      modelo_embedding: 'openai/text-embedding-3-small',\n\n      curso: {\n        id,\n        nombre,\n        descripcion,\n        categoria,\n        nivel,\n        duracion: d.duracion ?? null,\n        estado,\n        fecha_actualizacion: d.fecha_actualizacion,\n        texto_embedding: textoEmbedding\n      }\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
