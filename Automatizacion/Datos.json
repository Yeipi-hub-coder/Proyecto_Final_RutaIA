    {
      "parameters": {
        "jsCode": "const puntos = $json.data;\n\nif (!puntos || puntos.length === 0) {\n  throw new Error('No se generaron puntos para Qdrant');\n}\n\n// Recuperamos la configuración original\nconst config = $('Preparar Puntos').first().json;\n\n// Calculamos la fecha MÁS NUEVA procesada\nconst fechas = puntos\n  .map(p => p.fecha_actualizacion)\n  .filter(Boolean)\n  .map(f => new Date(f));\n\nif (fechas.length === 0) {\n  throw new Error('Los puntos no contienen fecha_actualizacion');\n}\n\nconst fechaMaxima = new Date(Math.max(...fechas));\n\nreturn [\n  {\n    json: {\n      qdrant_url: config.qdrant_url,\n      coleccion: config.coleccion,\n      vector_size: puntos[0].vector.length,\n      points: puntos,\n\n      ultimaFechaProcesada: fechaMaxima\n        .toISOString()\n        .slice(0, 19)\n        .replace('T', ' ')\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        160
      ],
      "id": "5e6dcd04-1343-4d9d-8ce1-b477ef686484",
      "name": "Armar Payload Final"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
