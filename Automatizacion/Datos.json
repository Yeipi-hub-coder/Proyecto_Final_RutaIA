    },
    {
      "parameters": {
        "jsCode": "const puntos = $json.data;\nconst config = $('Preparar Puntos1').first().json;\n\nreturn [\n  {\n    json: {\n      url: config.qdrant_url,\n      coleccion: config.coleccion,\n      vector_size: puntos[0].vector.length,\n      points: puntos\n    }\n  }\n];"
      },
